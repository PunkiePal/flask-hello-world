import tkinter as tk
from tkinter import messagebox
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CORE = ROOT / "Core_Modules"

MODULES = [
    ("MODULE 1", "Core Architecture of AI Ingestion"),
    ("MODULE 2", "Enterprise Purification Constraints Matrix"),
    ("MODULE 3", "Live System Sanitation Runtime Engine"),
    ("MODULE 4", "Operational Initialization Checklist"),
]

def show_message(title, message):
    messagebox.showinfo(title, message)

def module_action(number, title):
    import subprocess

    module_files = {
        "1": "hw_b2b_module_01_build.pyc",
        "2": "hw_b2b_module_02_build.pyc",
        "3": "hw_b2b_module_03_build.pyc",
        "4": "hw_b2b_module_04_build.pyc",
    }

    filename = module_files.get(number)

    if filename:
        module_path = CORE / filename
        result = subprocess.run(
            ["python3", str(module_path)],
            cwd=str(ROOT),
            capture_output=True,
            text=True,
        )
        output = result.stdout.strip()
        if result.returncode == 0:
            show_message(
                f"Module {number} Complete",
                output if output else f"Module {number} completed successfully."
            )
        else:
            show_message(
                f"Module {number} Error",
                result.stderr.strip() or f"Module {number} returned an error."
            )
    else:
        show_message(
            f"Module {number}",
            f"{title}\n\n"
            "This module is installed and ready for connection."
        )

def run_all():
    show_message(
        "RUN ALL",
        "The four Headwater B2B modules are installed.\n\n"
        "The execution layer will be connected after runtime verification."
    )

def open_documentation():
    show_message(
        "DOCUMENTATION",
        "Documentation and ingestion templates are located in the "
        "Headwater B2B Kit folders."
    )

def open_results():
    show_message(
        "RESULTS",
        "Results will appear here when module execution is connected."
    )

def open_logs():
    show_message(
        "LOGS",
        "Execution logs will appear here when module execution is connected."
    )

def system_check():
    pyc_files = list(CORE.glob("*.pyc"))
    message = (
        "SYSTEM CHECK\n\n"
        f"Python runtime: {__import__('sys').version.split()[0]}\n"
        f"Core module files found: {len(pyc_files)}\n"
    )

    if len(pyc_files) >= 4:
        message += "\nCore module check: READY"
    else:
        message += "\nCore module check: REVIEW REQUIRED"

    show_message("System Check", message)

root = tk.Tk()
root.title(" HeadWater B2B Data Purification & AI Ingestion Kit")
root.geometry("900x700")
root.minsize(760, 600)

title = tk.Label(
    root,
    text="HEADWATER AI DIGITAL PRODUCTS DIVISION",
    font=("Arial", 26, "bold")
)
title.pack(pady=(25, 5))

subtitle = tk.Label(
    root,
    text=" HEADWATER B2B DATA PURIFICATION & AI INGESTION KIT",
    font=("Arial", 14, "bold")
)
subtitle.pack(pady=(0, 25))
prompt = tk.Label(
    root,
    text="WHAT WOULD YOU LIKE TO DO?",
    font=("Arial", 13, "bold")
)
prompt.pack(pady=(5, 15))

for number, description in MODULES:
    button = tk.Button(
        root,
        text=f"{number}\n{description}",
        font=("Arial", 12, "bold"),
        height=3,
        width=55,
        command=lambda n=number[-1], d=description: module_action(n, d)
    )
    button.pack(pady=6)

run_button = tk.Button(
    root,
    text="RUN ALL",
    font=("Arial", 13, "bold"),
    height=2,
    width=25,
    command=run_all
)
run_button.pack(pady=15)

button_frame = tk.Frame(root)
button_frame.pack(pady=10)

for text, command in [
    ("SYSTEM CHECK", system_check),
    ("RESULTS", open_results),
    ("LOGS", open_logs),
    ("DOCUMENTATION", open_documentation),
]:
    tk.Button(
        button_frame,
        text=text,
        width=16,
        command=command
    ).pack(side="left", padx=5)

root.mainloop()
